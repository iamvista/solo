# ============================================
# solo.tw 環境變數範本
# 複製此檔案為 .env.local 並填入實際值
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (Email) ---
RESEND_API_KEY=re_your_api_key

# --- Newsletter ---
# Random ≥32 char string. Used as HMAC secret for unsubscribe tokens.
# Required: must NOT fall back to SUPABASE_SERVICE_ROLE_KEY.
# Generate: openssl rand -hex 32
NEWSLETTER_UNSUBSCRIBE_SECRET=

# --- Cron (Vercel) ---
# Vercel injects this automatically on Cron-protected routes; set in env to
# match for local testing. The /api/cron/daily-check route requires Bearer.
CRON_SECRET=

# --- LINE (Optional) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Site ---
NEXT_PUBLIC_BASE_URL=https://www.solo.tw

# --- Recur (https://recur.tw) ---
# Publishable 可暴露於 client；Secret 與 Webhook Secret 僅限 server。
NEXT_PUBLIC_RECUR_PUBLISHABLE_KEY=pk_test_...or_pk_live_...
RECUR_SECRET_KEY=sk_test_...or_sk_live_...
RECUR_WEBHOOK_SECRET=webhook_secret_from_recur_dashboard
NEXT_PUBLIC_RECUR_AI_COACH_KIT_PRODUCT_ID=xqvb9nqxtehhfesuhequm9jp

# --- Context Architecture DFY 服務 ---
# 在 Recur 後臺建立 ONE_TIME 產品後填入；上線前必須設定，否則前端會 disable 結帳按鈕。
# 早鳥（前 10 位 NT$ 8,800）與正式價（NT$ 12,000）建議建為兩個獨立 productId
# （Recur SDK 沒有 amount 覆寫，固定金額靠獨立產品實現）。
NEXT_PUBLIC_RECUR_CONTEXT_ARCH_DFY_EARLY_PRODUCT_ID=
NEXT_PUBLIC_RECUR_CONTEXT_ARCH_DFY_REGULAR_PRODUCT_ID=
# Calendly / Cal.com 預約連結（付款成功後 email 內容會帶這個 URL）
NEXT_PUBLIC_CONTEXT_ARCH_DFY_BOOKING_URL=https://cal.com/vista/context-architecture-dfy
