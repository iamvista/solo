# ============================================
# solo.tw 環境變數範本
# 複製此檔案為 .env.local 並填入實際值
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (Email) ---
RESEND_API_KEY=re_your_api_key

# --- PAYUNi 統一金流 ---
# 測試環境：https://sandbox-api.payuni.com.tw
# 正式環境：https://api.payuni.com.tw
PAYUNI_API_URL=https://sandbox-api.payuni.com.tw
PAYUNI_MER_ID=your_merchant_id
PAYUNI_HASH_KEY=your_32_char_hash_key_here_12345
PAYUNI_HASH_IV=your_16_char_iv__

# --- LINE (Optional) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Site ---
NEXT_PUBLIC_BASE_URL=https://www.solo.tw
